# Copy to .env and fill in before the first `docker compose up`.
#
# Variables without a default are required: compose refuses to start rather than
# silently substituting a development password, because a stack that comes up
# with known credentials is worse than one that refuses to come up.

# --- Required ---------------------------------------------------------------

# Database password. Used by the ns and the api to build their connection URLs.
POSTGRES_PASSWORD=

# LoRa network ID, 6 hex digits, e.g. 000000 or 123456. It is part of the DevAddr
# a device receives at join, so changing it later invalidates every session.
NETWORK_NET_ID=

# Authenticates the network server's application API, which the dashboard uses to
# provision devices and submit downlinks. At least 16 characters:
#   openssl rand -hex 24
NS_API_TOKEN=

# --- Optional ---------------------------------------------------------------

# Regional parameters the network server enforces. One of:
#   US915 (default), EU868, AS923, AS923-2, AS923-3, AS923-4
#
# This is a regulatory setting, not a preference: it decides the frequencies,
# duty cycles and transmit limits the server applies. Set it to the band your
# gateways and devices are certified for. The console offers this same list by
# reading it from the network server, so a band the server cannot enforce is
# never offered.
NETWORK_REGION=US915

# Where the console is published. Loopback by default; change to 0.0.0.0 only
# behind a reverse proxy that terminates TLS.
WEB_HTTP_PORT=8082
WEB_HTTP_BIND_ADDRESS=127.0.0.1

# Gateway-facing UDP port. Gateways must point at this port (the packet
# forwarder's default is 6858, so this usually needs no change).
NS_GATEWAY_BIND_ADDRESS=0.0.0.0
NS_GATEWAY_PORT=6858

# LoRa Basics Station (sx1302 concentrators: MTAC, CLS, RAK, Sensecap).
# A station dials ws://HOST:30001/connectedtcp/<GATEWAY_EUI>, so this port has
# to be reachable from the gateway the same way the UDP one is.
#
# The token is a shared secret the station presents in its URL. Without it the
# transport still works, but anything that can reach the port can claim to be
# any gateway EUI and receive that device's downlinks — acceptable on a bench,
# not on a LAN with other tenants. Set it to any string of at least 16
# characters and give the station the same value.
#
# Set NS_LBS_ADDR=off inside compose.yaml to close the transport entirely on a
# network that will never have a station.
NS_LBS_PORT=30001
NS_LBS_BIND_ADDRESS=0.0.0.0
NS_LBS_TOKEN=

# Optional: push a radio plan to stations instead of trusting each station's
# own. Value is a path inside the ns container, e.g. /etc/ns/sx1301_conf.json.
# NS_LBS_RADIO_PLAN=

# Optional: restrict which join servers stations forward, as a comma-separated
# list of 16-hex-digit EUIs. Empty forwards every join-request, which is what a
# single-operator deployment wants.
# NS_LBS_JOIN_EUIS=

# Status endpoint (health, gateway registry), published on loopback only.
NS_STATUS_PORT=8090

# debug | info | warn | error
NS_LOG_LEVEL=info

# --- MCP server (optional) --------------------------------------------------
#
# Lets an agent read the network — and, if told to, act on it — over the Model
# Context Protocol. Off unless you start it:
#
#   docker compose --profile mcp up -d
#
# The token is what authenticates agents to this listener. It must NOT be the
# same value as NS_API_TOKEN: one secret guarding both this door and the network
# server's API means one leak opens both, and neither can be rotated without the
# other. The process refuses to start when the two are equal.
#   openssl rand -hex 24
# MCP_AUTH_TOKEN=

# What the agent may do.
#
#   read     every tool is a read. This is the default and the right answer for
#            almost every deployment.
#   operate  adds queueing a downlink, cancelling one, asking a device for a
#            battery report, and changing a device's configuration.
#
# Neither profile can create or delete a device, change an integration, or
# install a payload formatter, whatever MCP_PROFILE says. mcp/README.md explains
# why those are excluded rather than merely gated.
# MCP_PROFILE=read

# Where the MCP listener is published. Loopback is the default because this
# speaks plain HTTP: a bearer token sent in the clear is readable by anyone who
# can see the wire, so 0.0.0.0 means putting TLS in front of it first.
# MCP_BIND_ADDRESS=127.0.0.1
# MCP_HTTP_PORT=8092

# debug | info | warn | error
# MCP_LOG_LEVEL=info

# Tell the console where to find the listener so its Agents page can report whether
# one is answering. Set this to the container address on the internal network; the
# page shows the address it probed, so a wrong one is visible rather than guessed.
#
# Leave it unset if you do not start the profile: the page then reports truthfully
# that this deployment has no listener, instead of reporting a service as broken
# because nothing answers a name that was never started.
# MCP_URL=http://mcp:8092

# The console's assistant: ask it why a device is quiet and it looks the answer up.
#
# It needs three things — a model endpoint, a model name, and MCP_URL to read through.
# Set LLM_BASE_URL and LLM_MODEL without MCP_URL and the assistant stays off on
# purpose: a model answering about a network it cannot see is worse than no answer,
# because it is not distinguishable from a correct one.
#
# LLM_BASE_URL is the OpenAI-compatible root including its version segment. Ollama and
# vLLM serve /v1; LM Studio answers both /v1 and the root.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Any name the endpoint recognises. A 7-8B model quantised is the smallest that
# follows a tool-use instruction reliably; smaller ones answer from general LoRaWAN
# knowledge instead of looking, which is the failure this design tries to prevent.
# LLM_MODEL=qwen2.5:7b-instruct
#
# Only needed for a hosted endpoint. Local runtimes ignore it. It is never logged and
# never shown in the page.
# LLM_API_KEY=
